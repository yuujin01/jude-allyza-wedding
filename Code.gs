const GUESTS = [{"name": "Anthony Jones Tyndall", "seats": 2, "companions": ["Sydney Dalisay"]}, {"name": "Fritzie Lourd Manlapat", "seats": 3, "companions": ["Melvin Manlapat", "Aezii Manlapat"]}, {"name": "Norverto Santos", "seats": 6, "companions": ["Roma Santos", "Joel Santos", "Jacquiline Santos", "Unyong Santos", "Lea Luz Dineroz"]}, {"name": "Francis Jarque", "seats": 5, "companions": ["Jenny Jarque", "Gracia Amor Jarque"], "unassigned_slots": 2}, {"name": "Riza Dela Cruz", "seats": 2, "companions": ["Noel Dela Cruz"]}, {"name": "Gretchen Peña", "seats": 2, "companions": ["Michael Peña"]}, {"name": "Alex Hernandez", "seats": 1, "companions": []}, {"name": "Jocelyn Manlapat", "seats": 2, "companions": ["Generoso Manlapat"]}, {"name": "Czarina Tyndall", "seats": 2, "companions": ["Ean Elivera"]}, {"name": "Nelson Manlapat", "seats": 2, "companions": ["Divina Manlapat"]}];\nconst SHEET_GUESTS="Guest Database", SHEET_RSVP="RSVP Responses";
function setup(){const ss=SpreadsheetApp.getActiveSpreadsheet();let g=ss.getSheetByName(SHEET_GUESTS)||ss.insertSheet(SHEET_GUESTS);let r=ss.getSheetByName(SHEET_RSVP)||ss.insertSheet(SHEET_RSVP);g.clear();r.clear();g.appendRow(["Main Guest Name","Allocated Seats","Suggested Companion Names (JSON)","Unique Invitation Code","RSVP Status"]);r.appendRow(["Main Guest Name","Attendance Status","Final Attendee Names (JSON)","Total Confirmed Attendees","Submission Date and Time"]);const rows=GUESTS;const data=rows.map(x=>[x.name,x.seats,JSON.stringify(x.companions),code_(), "Pending"]);if(data.length)g.getRange(2,1,data.length,5).setValues(data);g.setFrozenRows(1);r.setFrozenRows(1);g.autoResizeColumns(1,5);r.autoResizeColumns(1,5);}
function doPost(e){try{const body=JSON.parse(e.postData.contents||"{}");let out;if(body.action==="suggestions")out=suggestions_();else if(body.action==="lookup")out=lookup_(body);else if(body.action==="submit")out=submit_(body);else throw Error("Unknown action");return json_({ok:true,...out})}catch(err){return json_({ok:false,error:err.message})}}
function doGet(){return json_({ok:true,service:"Jude & Allyza RSVP API"})}
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
function sheets_(){const ss=SpreadsheetApp.getActive();return {g:ss.getSheetByName(SHEET_GUESTS),r:ss.getSheetByName(SHEET_RSVP)}}
function suggestions_(){const {g}=sheets_();if(!g)throw Error("Guest database is not initialized.");const vals=g.getDataRange().getValues();return {names:vals.slice(1).filter(x=>x[0]).map(x=>String(x[0]))}}
function lookup_(b){const {g,r}=sheets_();const vals=g.getDataRange().getValues();const name=String(b.name||"").trim().toLowerCase(),code=String(b.code||"").trim();const row=vals.slice(1).find(x=>String(x[0]).trim().toLowerCase()===name&&String(x[3])===code);if(!row)throw Error("We couldn't verify that invitation. Check the name and private code.");const existing=r.getDataRange().getValues().slice(1).find(x=>String(x[0]).toLowerCase()===name);return {guest:{name:row[0],seats:Number(row[1]),companions:JSON.parse(row[2]||"[]"),hasResponse:!!existing}}}
function submit_(b){const lock=LockService.getScriptLock();lock.waitLock(15000);try{const {g,r}=sheets_();const name=String(b.name||"").trim(),code=String(b.code||"").trim(),attendance=String(b.attendance||"");const vals=g.getDataRange().getValues();const row=vals.slice(1).find(x=>String(x[0]).toLowerCase()===name.toLowerCase()&&String(x[3])===code);if(!row)throw Error("Invitation verification failed.");if(!["Attending","Declines"].includes(attendance))throw Error("Invalid attendance selection.");let people=Array.isArray(b.attendees)?b.attendees.map(x=>String(x).trim()).filter(Boolean):[];if(attendance==="Attending"&&(people.length<1||people.length>Number(row[1])))throw Error("Attendee count exceeds the allocated seats or is empty.");if(attendance==="Declines")people=[];if(people.some(x=>x.length>100))throw Error("An attendee name is too long.");const response=r.getDataRange().getValues();const index=response.findIndex((x,i)=>i>0&&String(x[0]).toLowerCase()===name.toLowerCase());const data=[row[0],attendance,JSON.stringify(people),people.length,new Date()];if(index>0)r.getRange(index+1,1,1,data.length).setValues([data]);else r.appendRow(data);const guestIndex=vals.findIndex((x,i)=>i>0&&String(x[0]).toLowerCase()===name.toLowerCase());g.getRange(guestIndex+1,5).setValue(attendance);return {message:"RSVP saved."}}finally{lock.releaseLock()}}
\nfunction code_(){return Utilities.getUuid().replace(/-/g,"").slice(0,12).toUpperCase()}\n